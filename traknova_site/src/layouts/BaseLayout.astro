---
import { site } from '../data/site';
import { withBase } from '../utils/paths';
import '../styles/global.css';
import '../styles/enterprise.css';
const { title = site.brand, description = site.description } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand,
  url: Astro.site?.href,
  description: site.description,
  email: site.email,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: site.email,
    availableLanguage: ['English']
  }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101c2d" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      const toggle = document.querySelector('[data-menu-toggle]');
      const panel = document.querySelector('[data-mobile-menu]');
      toggle?.addEventListener('click', () => panel?.classList.toggle('is-open'));
      document.querySelectorAll('[data-inquiry-open]').forEach((el) => {
        el.addEventListener('click', () => document.querySelector('#inquiry-dialog')?.classList.add('is-open'));
      });
      document.querySelector('[data-dialog-close]')?.addEventListener('click', () => document.querySelector('#inquiry-dialog')?.classList.remove('is-open'));
      document.querySelector('#inquiry-dialog')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) e.currentTarget.classList.remove('is-open');
      });
      document.querySelectorAll('.product-image img, .detail-image img').forEach((img) => {
        img.addEventListener('error', () => {
          if (!img.dataset.fallbackApplied) {
            img.dataset.fallbackApplied = 'true';
            img.src = import.meta.env.BASE_URL + '/images/products/product-placeholder.svg';
          }
        });
      });
      const filterButtons = document.querySelectorAll('[data-filter]');
      filterButtons.forEach((button) => button.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('active'));
        button.classList.add('active');
        const category = button.getAttribute('data-filter');
        document.querySelectorAll('[data-product-category]').forEach((card) => {
          const match = category === 'all' || card.getAttribute('data-product-category') === category;
          card.classList.toggle('is-hidden', !match);
        });
      }));
    </script>
  </body>
</html>
