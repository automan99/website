---
import { site } from '../data/site';
import { withBase, localizedPath, getPathInfo } from '../utils/paths';
import { DEFAULT_LOCALE, ENABLED_LOCALES, LOCALE_META, type Locale } from '../i18n/config';
import { getDictionary } from '../i18n';
import ConsentBanner from '../components/ConsentBanner.astro';
import { CONSENT_STORAGE_KEY, CONSENT_VERSION } from '../scripts/consent.mjs';
import '../styles/global.css';
import '../styles/enterprise.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  locale?: Locale;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth = 2000,
  imageHeight = 1125,
  locale = DEFAULT_LOCALE
} = Astro.props;
const dict = getDictionary(locale);
const pageTitle = title ?? site.brand;
const pageDescription = description ?? dict.site.description;
const socialImage = image
  ? image.startsWith('http')
    ? image
    : Astro.site
      ? new URL(withBase(image), Astro.site).href
      : withBase(image)
  : undefined;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const logicalPath = getPathInfo(Astro.url.pathname).path;
const alternateUrl = (target: Locale) => {
  const path = localizedPath(target, logicalPath);
  return Astro.site ? new URL(path, Astro.site).href : path;
};
const googleAdsTagId = site.googleAds?.tagId?.trim() ?? '';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand,
  url: Astro.site?.href,
  description: dict.site.description,
  email: site.email,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: site.email,
    availableLanguage: ENABLED_LOCALES.map((enabled) => LOCALE_META[enabled].htmlLang)
  }
};
---
<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#08111c" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {ENABLED_LOCALES.map((enabled) => (
      <link rel="alternate" hreflang={LOCALE_META[enabled].htmlLang} href={alternateUrl(enabled)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternateUrl(DEFAULT_LOCALE)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt ?? pageTitle} />}
    {socialImage && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImage && <meta property="og:image:height" content={String(imageHeight)} />}
    <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
    {ENABLED_LOCALES.filter((enabled) => enabled !== locale).map((enabled) => (
      <meta property="og:locale:alternate" content={LOCALE_META[enabled].ogLocale} />
    ))}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    {googleAdsTagId && (
      <Fragment>
        <script
          is:inline
          define:vars={{ googleAdsTagId, consentKey: CONSENT_STORAGE_KEY, consentVersion: CONSENT_VERSION }}
        >
          window.dataLayer = window.dataLayer || [];
          window.gtag = window.gtag || function () {
            window.dataLayer.push(arguments);
          };
          window.gtag('js', new Date());

          let storedConsent = null;
          try {
            storedConsent = JSON.parse(window.localStorage.getItem(consentKey) || 'null');
          } catch (error) {
            storedConsent = null;
          }

          const granted =
            storedConsent &&
            storedConsent.version === consentVersion &&
            storedConsent.advertising === true
              ? 'granted'
              : 'denied';

          window.gtag('consent', 'default', {
            ad_storage: granted,
            ad_user_data: granted,
            ad_personalization: granted,
            analytics_storage: granted,
            functionality_storage: 'granted',
            security_storage: 'granted',
            wait_for_update: 500
          });
          window.gtag('config', googleAdsTagId);
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsTagId}`}></script>
      </Fragment>
    )}
    <link rel="stylesheet" href={withBase('/fonts/fonts.css')} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <ConsentBanner locale={locale} />
    <script>
      const toggle = document.querySelector('[data-menu-toggle]');
      const panel = document.querySelector('[data-mobile-menu]');
      toggle?.addEventListener('click', () => panel?.classList.toggle('is-open'));
      document.querySelectorAll('[data-print-brief]').forEach((el) => {
        el.addEventListener('click', () => window.print());
      });
    </script>
  </body>
</html>
