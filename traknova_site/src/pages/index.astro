---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryDialog from '../components/InquiryDialog.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { withBase } from '../utils/paths';
---
<BaseLayout title="TRAKNOVA | Industrial Mobility & Auto-ID Solutions">
  <Header />
  <main>
    <section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><span class="eyebrow">INDUSTRIAL MOBILITY & AUTO-ID</span><h1>Move Data.<br /><em>Move Business.</em></h1><p>Powering smarter operations with rugged mobile computers, RFID technology and intelligent data capture solutions — engineered for the real world.</p><div class="hero-actions"><a class="button button-accent" href={withBase('/products/')}>Explore Products →</a><a class="button button-glass" href={withBase('/contact/')}>Talk to Our Experts ↗</a></div><div class="hero-proof"><span><b>Built for Business</b>Enterprise-grade devices</span><span><b>OEM / ODM Ready</b>Your brand, your solution</span><span><b>Global Support</b>From concept to delivery</span></div></div>
    <div class="hero-visual"><div class="hero-orbit"></div><div class="device-stack"><div class="device device-tablet"><div class="screen"></div></div><div class="device device-pda"><div class="screen"></div><div class="keypad"></div></div><div class="device device-reader"><div class="reader-head"></div><div class="reader-grip"></div></div></div><div class="visual-chip chip-a">RFID + NFC<small>Intelligent identification</small></div><div class="visual-chip chip-b">RUGGED BY DESIGN<small>Ready for demanding workflows</small></div></div></div></section>
    <section class="trust-strip"><div class="wrap trust-inner"><span>TECHNOLOGY FOR CONNECTED OPERATIONS</span><b>RFID</b><b>BARCODE</b><b>NFC</b><b>ANDROID</b><b>INDUSTRIAL IoT</b></div></section>
    <section class="section"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">OUR PRODUCT PORTFOLIO</span><h2>Hardware that works<br />as hard as you do.</h2></div><p>Explore rugged PDA computers, RFID handhelds and rugged tablets for enterprise data capture.</p></div><div class="filter-row"><button class="filter active" data-filter="all">All Products</button><button class="filter" data-filter="Rugged PDA">Rugged PDA</button><button class="filter" data-filter="RFID">RFID</button><button class="filter" data-filter="Industrial Tablet">Industrial Tablets</button></div><div class="product-grid">{products.map((product) => <ProductCard product={product} />)}</div><div class="center mt-36"><a class="button button-outline" href={withBase('/products/')}>View All Products ↗</a></div></div></section>
    <section class="dark-stats"><div class="wrap stats-grid"><div><b>RFID</b><span>Advanced identification</span></div><div><b>1D / 2D</b><span>Barcode data capture</span></div><div><b>Android</b><span>Enterprise mobility</span></div><div><b>OEM / ODM</b><span>Flexible customization</span></div></div></section>
    <section class="section section-soft"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">INDUSTRY SOLUTIONS</span><h2>Designed for the way<br />your industry works.</h2></div><p>Purpose-built mobile technology helps teams capture data accurately, improve visibility and keep operations moving.</p></div><div class="industry-grid"><a class="industry-card industry-warehouse" href={withBase('/solutions/')}><span>01 / LOGISTICS</span><h3>Warehouse & Logistics</h3><p>Receiving · Picking · Inventory control</p></a><a class="industry-card industry-manufacturing" href={withBase('/solutions/')}><span>02 / INDUSTRY</span><h3>Manufacturing</h3><p>WIP tracking · Asset visibility</p></a><a class="industry-card industry-retail" href={withBase('/solutions/')}><span>03 / COMMERCE</span><h3>Retail & Field Service</h3><p>Stock accuracy · Mobile workforce</p></a></div></div></section>
    <section class="section"><div class="wrap"><div class="oem-panel"><div><span class="eyebrow">OEM / ODM PARTNERSHIP</span><h2>Build your next device.<br /><em>Under your brand.</em></h2><p>From logo customization to tailored hardware configurations, TRAKNOVA supports partners developing and scaling their own industrial mobility portfolio.</p><ul><li>Private label & branding</li><li>Hardware configuration</li><li>Accessory customization</li><li>Project-based development</li><li>Packaging & documentation</li><li>Production coordination</li></ul><a class="button button-accent" href={withBase('/oem-odm/')}>Explore OEM / ODM →</a></div><div class="oem-art"><div class="oem-ring"></div><div class="oem-device"></div><span>ENGINEERED TO YOUR SPECIFICATION</span></div></div></div></section>
    <section class="section section-soft"><div class="wrap cta-band"><div><span class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</span><h2>Have a project in mind?<br />Let's find the right solution.</h2><p>Tell us what you need. Our team will help identify the right device and configuration.</p></div><a class="button button-accent" href={withBase('/contact/')}>Send an Inquiry ↗</a></div></section>
  </main>
  <Footer /><InquiryDialog />
</BaseLayout>