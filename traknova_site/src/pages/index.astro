---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryDialog from '../components/InquiryDialog.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { withBase } from '../utils/paths';
---
<BaseLayout
  title="TRAKNOVA | Industrial Mobility & Auto-ID Solutions"
  description="Rugged mobile computers, RFID handhelds and industrial tablets for warehouse, manufacturing, retail and field service. Solution design, configuration and OEM / ODM cooperation."
>
  <Header />
  <main>
    <section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><span class="eyebrow">INDUSTRIAL MOBILITY &amp; AUTO-ID</span><h1>Move Data.<br /><em>Move Business.</em></h1><p>Powering smarter operations with rugged mobile computers, RFID technology and intelligent data capture solutions — engineered for the real world.</p><div class="hero-actions"><a class="button button-accent" href={withBase('/products/')}>Explore Products →</a><a class="button button-glass" href={withBase('/contact/')}>Talk to Our Experts ↗</a></div><div class="hero-proof"><span><b>Built for Business</b>Enterprise-grade devices</span><span><b>OEM / ODM Ready</b>Your brand, your solution</span><span><b>Global Support</b>From concept to delivery</span></div></div>
    <div class="hero-visual"><div class="hero-orbit"></div><div class="device-stack"><div class="device device-tablet"><div class="screen"></div></div><div class="device device-pda"><div class="screen"></div><div class="keypad"></div></div><div class="device device-reader"><div class="reader-head"></div><div class="reader-grip"></div></div></div><div class="visual-chip chip-a">RFID + NFC<small>Intelligent identification</small></div><div class="visual-chip chip-b">RUGGED BY DESIGN<small>Ready for demanding workflows</small></div></div></div></section>
    <section class="trust-strip"><div class="wrap trust-inner"><span>TECHNOLOGY FOR CONNECTED OPERATIONS</span><b>RFID</b><b>BARCODE</b><b>NFC</b><b>ANDROID</b><b>INDUSTRIAL IoT</b></div></section>

    <section class="section">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">WHY TRAKNOVA</span><h2>Hardware is only useful<br />when it fits the work.</h2></div>
          <p>We select and configure devices around the task: the capture method, the form factor, the software and the support path after rollout.</p>
        </div>
        <div class="pillar-grid">
          <article class="pillar"><b>01</b><h3>Rugged by design</h3><p>Devices chosen for warehouse, field and industrial environments. Protection and operating limits are confirmed per SKU.</p></article>
          <article class="pillar"><b>02</b><h3>Integrated auto-ID</h3><p>Barcode, UHF RFID, NFC and document capture configured around the workflow, not added afterwards.</p></article>
          <article class="pillar"><b>03</b><h3>Configuration flexibility</h3><p>Android and Windows platforms, multiple form factors and module options for regional requirements.</p></article>
          <article class="pillar"><b>04</b><h3>OEM / ODM ready</h3><p>Private label, configured products and project development under your brand and your documentation.</p></article>
        </div>
      </div>
    </section>

    <section class="section section-soft"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">OUR PRODUCT PORTFOLIO</span><h2>Hardware that works<br />as hard as you do.</h2></div><p>Explore rugged PDA computers, RFID handhelds and rugged tablets for enterprise data capture.</p></div><div class="filter-row"><button class="filter active" data-filter="all">All Products</button><button class="filter" data-filter="Rugged PDA">Rugged PDA</button><button class="filter" data-filter="RFID">RFID</button><button class="filter" data-filter="Industrial Tablet">Industrial Tablets</button></div><div class="product-grid">{products.map((product) => <ProductCard product={product} />)}</div><div class="center mt-36"><a class="button button-outline" href={withBase('/products/')}>View All Products ↗</a></div></div></section>

    <section class="dark-stats"><div class="wrap stats-grid"><div><b>RFID</b><span>Advanced identification</span></div><div><b>1D / 2D</b><span>Barcode data capture</span></div><div><b>Android</b><span>Enterprise mobility</span></div><div><b>OEM / ODM</b><span>Flexible customization</span></div></div></section>

    <section class="section">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">SOLUTIONS IN PRACTICE</span><h2>Start from the workflow.<br />Then choose the device.</h2></div>
          <p>Each industry page maps common tasks to capture methods, device configurations and a deployment path.</p>
        </div>
        <div class="solution-entry-grid">
          <a class="solution-entry solution-warehouse" href={withBase('/solutions/#logistics')}>
            <span class="entry-index">01 / LOGISTICS</span>
            <h3>Warehouse &amp; Logistics</h3>
            <p>Receiving, put-away, cycle counting, picking and dispatch — captured before inventory reaches the WMS.</p>
            <div class="entry-tags"><span>Barcode</span><span>UHF RFID</span><span>Mobile print</span></div>
            <span class="entry-link">Explore logistics solutions <span>↗</span></span>
          </a>
          <a class="solution-entry solution-manufacturing" href={withBase('/solutions/#manufacturing')}>
            <span class="entry-index">02 / MANUFACTURING</span>
            <h3>Manufacturing</h3>
            <p>Work orders, WIP, material traceability and maintenance rounds captured at the point of work.</p>
            <div class="entry-tags"><span>Barcode</span><span>Wired I/O</span><span>Rugged tablets</span></div>
            <span class="entry-link">Explore manufacturing solutions <span>↗</span></span>
          </a>
          <a class="solution-entry solution-retail" href={withBase('/solutions/#retail')}>
            <span class="entry-index">03 / RETAIL</span>
            <h3>Retail &amp; Commerce</h3>
            <p>Replenishment, price accuracy, RFID stocktakes and labeling at the point of decision.</p>
            <div class="entry-tags"><span>Barcode</span><span>UHF RFID</span><span>Mobile print</span></div>
            <span class="entry-link">Explore retail solutions <span>↗</span></span>
          </a>
          <a class="solution-entry solution-field" href={withBase('/solutions/#field-service')}>
            <span class="entry-index">04 / FIELD SERVICE</span>
            <h3>Field Service &amp; Assets</h3>
            <p>Inspections, digital work orders, asset audits and on-site documentation for mobile teams.</p>
            <div class="entry-tags"><span>Rugged tablets</span><span>UHF RFID</span><span>Documentation</span></div>
            <span class="entry-link">Explore field solutions <span>↗</span></span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">HOW WE WORK</span><h2>A practical path<br />from requirement to rollout.</h2></div>
          <p>The same four gates apply whether you are evaluating a single device or planning a fleet deployment.</p>
        </div>
        <div class="deploy-grid">
          <article class="deploy-step"><h3>Workflow review</h3><p>Map the steps, exceptions and data each step must produce before selecting hardware.</p></article>
          <article class="deploy-step"><h3>Configuration</h3><p>Choose form factor, capture modules, OS, accessories and integration points.</p></article>
          <article class="deploy-step"><h3>Pilot</h3><p>Deploy to one site or shift and compare accuracy, cycle time and exception rates.</p></article>
          <article class="deploy-step"><h3>Rollout &amp; support</h3><p>Stage devices, configure MDM, train users, plan spares and agree the support path.</p></article>
        </div>
      </div>
    </section>

    <section class="section"><div class="wrap"><div class="oem-panel"><div><span class="eyebrow">OEM / ODM PARTNERSHIP</span><h2>Build your next device.<br /><em>Under your brand.</em></h2><p>From logo customization to tailored hardware configurations, TRAKNOVA supports partners developing and scaling their own industrial mobility portfolio.</p><ul><li>Private label &amp; branding</li><li>Hardware configuration</li><li>Accessory customization</li><li>Project-based development</li><li>Packaging &amp; documentation</li><li>Production coordination</li></ul><a class="button button-accent" href={withBase('/oem-odm/')}>Explore OEM / ODM →</a></div><div class="oem-art"><div class="oem-ring"></div><div class="oem-device"></div><span>ENGINEERED TO YOUR SPECIFICATION</span></div></div></div></section>

    <section class="section section-soft">
      <div class="wrap faq-split">
        <div>
          <span class="eyebrow">COMMON QUESTIONS</span>
          <h2>Before you<br />send an inquiry.</h2>
          <p>If your question is not here, include it in the form. We will answer it against your workflow and target market.</p>
          <div class="mt-36"><a class="button button-outline" href={withBase('/contact/')}>Ask a Question ↗</a></div>
        </div>
        <div class="faq-list">
          <details><summary>Do you supply samples?</summary><p>Sample and pilot policy is agreed per project. For configured products, a prototype or pilot build is the usual acceptance step before a production order.</p></details>
          <details><summary>Can devices be branded for our company?</summary><p>Yes. Private label and configured-product cooperation are covered on the OEM / ODM page, including logo, packaging, documentation and software image options.</p></details>
          <details><summary>Do you support regional RFID frequencies?</summary><p>UHF RFID bands and market approvals differ by country. We confirm the target market before selecting the module and include the applicable configuration in the proposal.</p></details>
          <details><summary>How do I get a datasheet?</summary><p>Send an inquiry with the model and configuration you are evaluating. We will confirm the applicable datasheet, options and availability for your market.</p></details>
        </div>
      </div>
    </section>

    <section class="section"><div class="wrap cta-band"><div><span class="eyebrow">LET'S TALK ABOUT YOUR PROJECT</span><h2>Have a project in mind?<br />Let's find the right solution.</h2><p>Tell us what you need. Our team will help identify the right device and configuration.</p></div><a class="button button-accent" href={withBase('/contact/')}>Send an Inquiry ↗</a></div></section>
  </main>
  <Footer /><InquiryDialog />
</BaseLayout>
