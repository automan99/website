---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import InquiryDialog from '../components/InquiryDialog.astro'; import { site } from '../data/site';
---
<BaseLayout title="Contact TRAKNOVA | Request a Quote"><Header/><main><section class="page-hero"><div class="wrap"><span class="eyebrow">CONTACT OUR TEAM</span><h1>Let's build the right<br/><em>solution together.</em></h1><p>Share your product requirements, target quantity or OEM / ODM project details.</p></div></section><section class="section"><div class="wrap contact-grid"><div><h2>Talk to our sales team.</h2><p>Choose the channel that works best for you. Replace the demo contact details in the site configuration before launch.</p><a class="contact-row" href={`mailto:${site.email}`}><b>Email</b><span>{site.email}</span></a><a class="contact-row" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer"><b>WhatsApp</b><span>Start a conversation ↗</span></a><a class="contact-row" href={site.facebook} target="_blank" rel="noreferrer"><b>Facebook</b><span>Visit our page ↗</span></a></div><div class="contact-card"><span class="eyebrow">PROJECT INQUIRY</span><h2>Request a Quote</h2><p>Send us your requirements and we'll get back to you.</p><button class="button button-accent" data-inquiry-open>Open Inquiry Form ↗</button></div></div></section></main><Footer/><InquiryDialog/></BaseLayout>