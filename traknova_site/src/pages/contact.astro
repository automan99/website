---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryDialog from '../components/InquiryDialog.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const steps = [
  { title: 'Requirement review', body: 'We read the workflow, target market, expected volume and any OEM / ODM scope.' },
  { title: 'Clarification', body: 'We come back with the configuration questions that matter — modules, environment, software and timing.' },
  { title: 'Recommendation', body: 'You receive a shortlist, the relevant specifications and the documentation path for each option.' },
  { title: 'Quotation', body: 'Commercial terms, sample policy and lead time are confirmed for the selected configuration.' }
];

const faqs = [
  {
    q: 'What information should I include in an inquiry?',
    a: 'The workflow or task, the target market, the expected quantity and any required capture method (barcode, UHF RFID, mobile print or document reading). If you already have a device or software platform in mind, include it.'
  },
  {
    q: 'Will I receive a datasheet before ordering?',
    a: 'Yes. Once the model and target market are clear, we provide the applicable datasheet and confirm the configuration-dependent values. For some models the public page shows only confirmed values, with the full sheet available on request.'
  },
  {
    q: 'Do you support samples?',
    a: 'Sample and pilot policy is agreed per project. For configured products, a prototype or pilot build is the usual acceptance step before a production order.'
  },
  {
    q: 'Can you sign an NDA?',
    a: 'Yes, where the project involves confidential workflow, software or commercial information. Raise it in the inquiry and we will agree the process before detailed information is exchanged.'
  },
  {
    q: 'Do you handle OEM / ODM inquiries through the same form?',
    a: 'Yes. Select the cooperation interest in the form and describe the branding, configuration or development requirement. The OEM / ODM page describes the three engagement models and the six-stage process.'
  },
  {
    q: 'How are regional approvals handled?',
    a: 'Certification scope depends on the target market, device configuration and applicable standard. We review the requirement during discovery and confirm the documentation path for the selected configuration.'
  }
];
---
<BaseLayout
  title="Contact TRAKNOVA | Request a Quote"
  description="Contact TRAKNOVA about rugged PDA computers, RFID devices, industrial tablets, OEM / ODM projects and product datasheets."
>
  <Header />
  <main>
    <section class="page-hero">
      <div class="wrap">
        <span class="eyebrow">CONTACT OUR TEAM</span>
        <h1>Let's build the right<br /><em>solution together.</em></h1>
        <p>Share your workflow, target market and configuration questions. We will come back with a device shortlist and the information you need to evaluate it.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap contact-grid">
        <div>
          <span class="eyebrow">TALK TO OUR SALES TEAM</span>
          <h2>Choose the channel<br />that works for you.</h2>
          <p>Use email or WhatsApp for a direct conversation. For a longer requirement, the inquiry form captures the details we need to respond properly.</p>
          <a class="contact-row" href={`mailto:${site.email}`}><b>Email</b><span>{site.email}</span></a>
          <a class="contact-row" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer"><b>WhatsApp</b><span>Start a conversation ↗</span></a>
          <a class="contact-row" href={site.facebook} target="_blank" rel="noreferrer"><b>Facebook</b><span>Visit our page ↗</span></a>
          <div class="mt-36">
            <span class="mini-label">What to include</span>
            <ul class="outcome-list">
              <li>The workflow or task to be captured</li>
              <li>Target market and expected quantity</li>
              <li>Required capture method: barcode, RFID, print or document</li>
              <li>Timeline and OEM / ODM interest</li>
            </ul>
          </div>
        </div>
        <div class="contact-card">
          <span class="eyebrow">PROJECT INQUIRY</span>
          <h2>Request a Quote</h2>
          <p>Send us your requirements and we will confirm the next step.</p>
          <button class="button button-accent" data-inquiry-open>Open Inquiry Form ↗</button>
          <p class="note-line">We use your information only to respond to this inquiry. See our <a href={withBase('/privacy/')}>Privacy Policy</a>.</p>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">WHAT HAPPENS NEXT</span><h2>From inquiry<br />to a clear next step.</h2></div>
          <p>We do not send a catalogue and hope for the best. Each inquiry is reviewed against the workflow and the market.</p>
        </div>
        <div class="deploy-grid">
          {steps.map((step) => (
            <article class="deploy-step"><h3>{step.title}</h3><p>{step.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="special-grid">
          <article class="special-card">
            <span class="mini-label">INTERNATIONAL SUPPORT</span>
            <h3>Working across markets.</h3>
            <p>We work with distributors, solution providers and enterprise teams across markets. Regional availability, approvals and lead times are confirmed per project.</p>
            <ul>
              <li>Device and module availability by market</li>
              <li>Regional UHF RFID bands and approvals</li>
              <li>Documentation and packaging requirements</li>
            </ul>
          </article>
          <article class="special-card">
            <span class="mini-label">EXISTING CUSTOMER?</span>
            <h3>Order and support queries.</h3>
            <p>For order status, spare parts or an RMA discussion, contact the sales contact on your order and include the model, serial number and a short description of the issue.</p>
            <ul>
              <li>Model and serial number</li>
              <li>Order or invoice reference</li>
              <li>Photos or logs where relevant</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap faq-split">
        <div>
          <span class="eyebrow">CONTACT FAQ</span>
          <h2>Before you<br />write to us.</h2>
          <p>If your question is not here, include it in the inquiry. We will answer it against your workflow and target market.</p>
          <div class="mt-36"><a class="button button-outline" href={withBase('/products/')}>Browse Products ↗</a></div>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details><summary>{faq.q}</summary><p>{faq.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap cta-band">
        <div>
          <span class="eyebrow">READY WHEN YOU ARE</span>
          <h2>Tell us what<br />you are trying to do.</h2>
          <p>A short description of the workflow is enough to start. We will ask for the rest.</p>
        </div>
        <button class="button button-accent" data-inquiry-open>Send an Inquiry ↗</button>
      </div>
    </section>
  </main>
  <Footer /><InquiryDialog />
</BaseLayout>
