---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InquiryDialog from '../../components/InquiryDialog.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts } from '../../data/products';
import { withBase } from '../../utils/paths';

const products = getProducts('en');

const pdas = products.filter((product) => product.category === 'Rugged PDA');
const rfid = products.filter((product) => product.category === 'RFID');
const tablets = products.filter((product) => product.category === 'Industrial Tablet');

const taskCards = [
  {
    title: 'Barcode scanning and identification',
    body: 'Receiving, picking, work orders and shelf checks where a precise, close-range read is required.',
    models: [
      { label: 'HT400', slug: 'ht400-rugged-barcode-pda' },
      { label: 'HT510', slug: 'ht510-rugged-pda' },
      { label: 'HT520', slug: 'ht520-multifunction-pda' }
    ]
  },
  {
    title: 'UHF RFID and bulk inventory',
    body: 'Cycle counts, item-level stocktakes and asset audits where tags must be read in volume.',
    models: [
      { label: 'HT550', slug: 'ht550-uhf-rfid-handheld' },
      { label: 'Y100 RFID', slug: 'y100-uhf-rfid-tablet' },
      { label: 'HT540', slug: 'ht540-rfid-handheld' }
    ]
  },
  {
    title: 'Mobile printing',
    body: 'Labels, receipts and service documents printed at the pack station, in the aisle or on site.',
    models: [{ label: 'HT800', slug: 'ht800-scan-print-pda' }]
  },
  {
    title: 'Industrial I/O and Windows software',
    body: 'Equipment connection, line-side applications and Windows-based field service software.',
    models: [
      { label: 'A100', slug: 'a100-windows-rugged-tablet' },
      { label: 'T120A', slug: 't120a-windows-industrial-tablet' }
    ]
  },
  {
    title: 'ID and document capture',
    body: 'Controlled identity and document workflows at counters, checkpoints and in the field.',
    models: [{ label: 'HT530', slug: 'ht530-document-id-pda' }]
  },
  {
    title: 'Field and vehicle mobility',
    body: 'Compact and large-format tablets for technicians, inspectors and mobile teams.',
    models: [
      { label: 'Y70', slug: 'y70-rugged-tablet' },
      { label: 'Y100', slug: 'y100-rugged-android-tablet' },
      { label: 'A100', slug: 'a100-windows-rugged-tablet' }
    ]
  }
];

const comparisonRows = [
  { series: 'HT400', family: 'Rugged PDA', form: 'Compact handheld', capture: '1D / 2D barcode', os: 'Confirm by SKU', workflow: 'Receiving, picking, field capture' },
  { series: 'HT510 family', family: 'Rugged PDA', form: 'Standard / pistol-grip / medical', capture: 'Barcode', os: 'Confirm by SKU', workflow: 'Scan-intensive tasks, healthcare-oriented' },
  { series: 'HT520', family: 'Rugged PDA', form: 'Multifunction handheld', capture: 'Barcode / NFC options', os: 'Confirm by SKU', workflow: 'Enterprise data collection' },
  { series: 'HT530', family: 'Rugged PDA', form: 'Specialized handheld', capture: 'Document / ID reader', os: 'Confirm by SKU', workflow: 'Identity and document workflows' },
  { series: 'HT800', family: 'Rugged PDA', form: 'Handheld with printer', capture: 'Barcode + mobile print', os: 'Confirm by SKU', workflow: 'On-the-spot labeling' },
  { series: 'HT540', family: 'RFID', form: 'RFID handheld', capture: 'Short-range RFID', os: 'Confirm by SKU', workflow: 'Close-proximity identification' },
  { series: 'HT550', family: 'RFID', form: 'UHF RFID handheld', capture: 'UHF RFID, 860–960 MHz', os: 'Android 10', workflow: 'Bulk inventory, asset tracking' },
  { series: 'Y100 RFID', family: 'RFID', form: '10.1-inch rugged tablet', capture: 'UHF RFID + optional modules', os: 'Android 13', workflow: 'Inventory, logistics, asset management' },
  { series: 'Y100 Android', family: 'Industrial Tablet', form: '10.1-inch rugged tablet', capture: 'Barcode / NFC / RFID options', os: 'Android', workflow: 'Mobile workforce, inspection' },
  { series: 'Y70', family: 'Industrial Tablet', form: '7-inch compact tablet', capture: 'Barcode options', os: 'Android / Windows', workflow: 'Field operations' },
  { series: 'A100', family: 'Industrial Tablet', form: '10.1-inch Windows tablet', capture: 'RJ45, RS232 / RS485, USB', os: 'Windows 10 / 11', workflow: 'Equipment connectivity, field service' },
  { series: 'T120A', family: 'Industrial Tablet', form: '12.6-inch Windows tablet', capture: 'Confirm by SKU', os: 'Windows', workflow: 'Large-screen industrial applications' }
];

const faqs = [
  {
    q: 'How do I choose between a PDA and a tablet?',
    a: 'Start with the task. A PDA is better for one-handed scanning in aisles, on a ladder or in the field. A tablet is better when the operator needs a larger screen, Windows software, equipment ports or a vehicle mount. The workflow review on our Solutions page describes the usual patterns.'
  },
  {
    q: 'Are the specifications on this site final?',
    a: 'Only confirmed values are shown. Configuration-dependent items are confirmed against the approved datasheet for your SKU, because modules, memory, OS versions and regional approvals vary between models and markets.'
  },
  {
    q: 'Can you configure modules for a specific project?',
    a: 'Yes, subject to the selected platform. Barcode engines, RFID modules, NFC, document readers, memory and accessories are reviewed against the application, target market and production plan. Some options require tooling or minimum quantities.'
  },
  {
    q: 'How do I compare two models for my workflow?',
    a: 'Send us the workflow, environment, target market and expected volume. We will narrow the range and confirm the configuration, accessories and documentation path for each option.'
  }
];
---
<BaseLayout
  title="Products | TRAKNOVA"
  description="Explore TRAKNOVA rugged PDA computers, RFID handhelds and industrial tablets. Find the right capture method for receiving, inventory, manufacturing, retail and field service."
>
  <Header />
  <main>
    <section class="page-hero">
      <div class="wrap">
        <span class="eyebrow">PRODUCT PORTFOLIO</span>
        <h1>Industrial hardware.<br /><em>Purpose-built performance.</em></h1>
        <p>Rugged PDA computers, RFID handhelds and industrial tablets for data capture, identification and mobile work. Configurations are confirmed against the approved datasheet for your market.</p>
        <div class="anchor-chips">
          <a class="anchor-chip" href="#task-selector">Start with the task</a>
          <a class="anchor-chip" href="#rugged-pda">Rugged PDA</a>
          <a class="anchor-chip" href="#rfid">RFID</a>
          <a class="anchor-chip" href="#industrial-tablets">Industrial tablets</a>
          <a class="anchor-chip" href="#comparison">Compare</a>
        </div>
      </div>
    </section>

    <section class="section" id="task-selector">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">START WITH THE TASK</span><h2>What does the device<br />need to do?</h2></div>
          <p>Six common requirements and the platform families that fit them. Use this as a shortlist, then confirm the configuration with our team.</p>
        </div>
        <div class="task-grid">
          {taskCards.map((task) => (
            <article class="task-card">
              <h3>{task.title}</h3>
              <p>{task.body}</p>
              <div class="device-list">
                {task.models.map((model) => (
                  <a class="device-link" href={withBase(`/products/${model.slug}/`)}>{model.label} <span>›</span></a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">THREE PRODUCT FAMILIES</span><h2>One range,<br />three ways to work.</h2></div>
          <p>Each family has a different balance of screen size, capture capability and operating environment.</p>
        </div>
        <div class="family-grid">
          <article class="family-card">
            <span class="family-count">05 MODELS</span>
            <h3>Rugged PDA</h3>
            <p>Handheld computers for one-handed scanning, field capture and task-specific modules.</p>
            <ul>
              <li>Barcode and multifunction handhelds</li>
              <li>Pistol-grip and medical variants</li>
              <li>Scan-and-print and ID capture configurations</li>
            </ul>
            <a class="text-link" href="#rugged-pda">View rugged PDA models →</a>
          </article>
          <article class="family-card">
            <span class="family-count">03 MODELS</span>
            <h3>RFID</h3>
            <p>Short-range and UHF RFID devices for item-level identification, inventory and asset tracking.</p>
            <ul>
              <li>UHF handheld for bulk reads</li>
              <li>Short-range RFID handheld</li>
              <li>10.1-inch UHF RFID tablet</li>
            </ul>
            <a class="text-link" href="#rfid">View RFID models →</a>
          </article>
          <article class="family-card">
            <span class="family-count">04 MODELS</span>
            <h3>Industrial Tablets</h3>
            <p>Rugged Android and Windows tablets for larger screens, industrial software and equipment I/O.</p>
            <ul>
              <li>7-inch and 10.1-inch Android</li>
              <li>10.1-inch Windows with wired I/O</li>
              <li>12.6-inch large-format Windows</li>
            </ul>
            <a class="text-link" href="#industrial-tablets">View tablet models →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="rugged-pda">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">RUGGED PDA</span><h2>Handhelds for<br />the point of work.</h2></div>
          <p>Compact, configurable terminals for scanning, identification and task-specific workflows.</p>
        </div>
        <div class="product-grid">{pdas.map((product) => <ProductCard product={product} />)}</div>
      </div>
    </section>

    <section class="section section-soft" id="rfid">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">RFID</span><h2>Identify in bulk,<br />not one at a time.</h2></div>
          <p>Short-range and UHF RFID platforms for inventory, asset audits and item-level workflows.</p>
        </div>
        <div class="product-grid">{rfid.map((product) => <ProductCard product={product} />)}</div>
      </div>
    </section>

    <section class="section" id="industrial-tablets">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">INDUSTRIAL TABLETS</span><h2>A larger screen<br />for bigger workflows.</h2></div>
          <p>Rugged Android and Windows tablets for inspection, field service, vehicle use and equipment-adjacent work.</p>
        </div>
        <div class="product-grid">{tablets.map((product) => <ProductCard product={product} />)}</div>
      </div>
    </section>

    <section class="section section-soft" id="comparison">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">COMPARE THE RANGE</span><h2>Series at<br />a glance.</h2></div>
          <p>Form factor and capture method are the fastest way to narrow the range. Final configuration follows the application review.</p>
        </div>
        <div class="matrix-wrap">
          <table class="matrix-table series-table">
            <thead>
              <tr><th>Series</th><th>Family</th><th>Form factor</th><th>Capture / I/O</th><th>OS family</th><th>Typical workflow</th></tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr><td>{row.series}</td><td>{row.family}</td><td>{row.form}</td><td>{row.capture}</td><td>{row.os}</td><td>{row.workflow}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note-line">“Confirm by SKU” means the value depends on the selected model and market. It is not a published specification.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split-intro">
          <div><span class="eyebrow">MODULES, ACCESSORIES &amp; DEPLOYMENT</span><h2>The device is<br />only the start.</h2></div>
          <p>A working deployment also needs the right modules, accessories and a plan for software and staging.</p>
        </div>
        <div class="quality-grid">
          <article class="quality-card">
            <h3>Capture modules</h3>
            <p>Module availability depends on the model and market.</p>
            <ul>
              <li>1D / 2D scan engines</li>
              <li>UHF RFID and short-range RFID</li>
              <li>NFC and document readers</li>
              <li>Optional camera configurations</li>
            </ul>
          </article>
          <article class="quality-card">
            <h3>Accessories</h3>
            <p>The accessory range is confirmed per SKU and project.</p>
            <ul>
              <li>Chargers and multi-bay cradles</li>
              <li>Pistol grips and hand straps</li>
              <li>Protective cases and covers</li>
              <li>Vehicle mounts and brackets</li>
            </ul>
          </article>
          <article class="quality-card">
            <h3>Software &amp; rollout</h3>
            <p>Deployment scope is agreed before the order.</p>
            <ul>
              <li>Android or Windows image</li>
              <li>Preloaded applications</li>
              <li>MDM enrollment and staging</li>
              <li>Pilot and rollout planning</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap faq-split">
        <div>
          <span class="eyebrow">PRODUCT FAQ</span>
          <h2>Questions before<br />you shortlist.</h2>
          <p>If your question is not here, send it with your workflow and target market. We will answer it against the actual configuration.</p>
          <div class="mt-36"><a class="button button-outline" href={withBase('/contact/')}>Request a Datasheet ↗</a></div>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details><summary>{faq.q}</summary><p>{faq.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap cta-band">
        <div>
          <span class="eyebrow">NEED HELP CHOOSING?</span>
          <h2>Tell us the task.<br />We will narrow the range.</h2>
          <p>Share the workflow, environment and target market. We will come back with a shortlist and the configuration questions that matter.</p>
        </div>
        <a class="button button-accent" href={withBase('/contact/')}>Send an Inquiry ↗</a>
      </div>
    </section>
  </main>
  <Footer /><InquiryDialog />
</BaseLayout>
