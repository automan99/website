---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import InquiryDialog from '../../components/InquiryDialog.astro'; import ProductCard from '../../components/ProductCard.astro'; import { products } from '../../data/products';
---
<BaseLayout title="Products | TRAKNOVA"><Header /><main><section class="page-hero"><div class="wrap"><span class="eyebrow">PRODUCT PORTFOLIO</span><h1>Industrial hardware.<br /><em>Purpose-built performance.</em></h1><p>Explore TRAKNOVA rugged PDA computers, RFID handhelds and rugged industrial tablets. Models and configurations are being verified against approved product datasheets.</p></div></section><section class="section"><div class="wrap"><p class="fineprint">Product imagery on this preview is linked to the domestic product catalogue where available. Please replace with approved high-resolution originals before public launch.</p><div class="product-grid">{products.map((product)=><ProductCard product={product}/>)}</div></div></section></main><Footer/><InquiryDialog/></BaseLayout>