---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import InquiryDialog from '../../components/InquiryDialog.astro'; import { products } from '../../data/products'; import { withBase } from '../../utils/paths';
export function getStaticPaths(){ return products.map((product)=>({params:{slug:product.slug},props:{product}})); }
const { product } = Astro.props;
---
<BaseLayout title={`${product.name} | TRAKNOVA`} description={product.summary}><Header/><main><section class="page-hero"><div class="wrap"><span class="eyebrow">{product.category}</span><h1>{product.name}</h1><p>{product.summary}</p></div></section><section class="section"><div class="wrap product-detail"><div class="detail-image"><img src={withBase(product.image)} alt={product.name} /></div><div><span class="product-category">{product.model}</span><h2>Designed for demanding workflows.</h2><p>{product.summary}</p><ul class="check-list">{product.highlights.map((item)=><li>{item}</li>)}</ul><button class="button button-accent" data-inquiry-open>Request Datasheet & Quote ↗</button></div></div><div class="wrap specs-wrap"><h2>Technical Specifications</h2><table class="spec-table"><tbody>{Object.entries(product.specs).map(([key,value])=><tr><th>{key}</th><td>{value}</td></tr>)}</tbody></table><p class="fineprint">Specifications are transcribed from the domestic catalogue where stated. Optional modules, regional variants and inconsistent protection claims must be confirmed against the approved datasheet before quotation. <a href={product.sourceUrl} target="_blank" rel="noreferrer">View domestic source ↗</a></p></div></section></main><Footer/><InquiryDialog/></BaseLayout>