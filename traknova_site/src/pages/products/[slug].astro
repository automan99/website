---
import ProductDetailView from '../../views/ProductDetailView.astro';
import { getProductFamilies } from '../../data/products/catalog';

export function getStaticPaths() {
  return getProductFamilies('en').map((family) => ({
    params: { slug: family.slug },
    props: { family }
  }));
}

const { family } = Astro.props;
---
<ProductDetailView locale="en" family={family} />
