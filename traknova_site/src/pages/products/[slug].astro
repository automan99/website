---
import ProductDetailView from '../../views/ProductDetailView.astro';
import { getProducts } from '../../data/products';

export function getStaticPaths() {
  return getProducts('en').map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---
<ProductDetailView locale="en" product={product} />
