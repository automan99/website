---
import LegalView from '../../views/LegalView.astro';
import { termsDocument } from '../../data/legal/en';
import { localizedRouteParams } from '../../i18n/routes';
import type { Locale } from '../../i18n/config';

export function getStaticPaths() {
  return localizedRouteParams();
}

const locale = Astro.params.lang as Locale;
---
<LegalView locale={locale} document={termsDocument} />
