---
import ProductDetailView from '../../../views/ProductDetailView.astro';
import { getProducts } from '../../../data/products';
import { localizedRouteParams } from '../../../i18n/routes';
import type { Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return localizedRouteParams().flatMap(({ params }) =>
    getProducts(params.lang).map((product) => ({
      params: { lang: params.lang, slug: product.slug },
      props: { product }
    }))
  );
}

const locale = Astro.params.lang as Locale;
const { product } = Astro.props;
---
<ProductDetailView locale={locale} product={product} />
