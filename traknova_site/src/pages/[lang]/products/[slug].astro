---
import ProductDetailView from '../../../views/ProductDetailView.astro';
import { getProductFamilies } from '../../../data/products/catalog';
import { localizedRouteParams } from '../../../i18n/routes';
import type { Locale } from '../../../i18n/config';

export function getStaticPaths() {
  return localizedRouteParams().flatMap(({ params }) =>
    getProductFamilies(params.lang).map((family) => ({
      params: { lang: params.lang, slug: family.slug },
      props: { family }
    }))
  );
}

const locale = Astro.params.lang as Locale;
const { family } = Astro.props;
---
<ProductDetailView locale={locale} family={family} />
