---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryDialog from '../components/InquiryDialog.astro';
import SolutionImage from '../components/SolutionImage.astro';
import { localizedPath, withBase } from '../utils/paths';
import { getSolutions } from '../data/solutions';
import { getProduct } from '../data/products';
import type { Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const copy = dict.solutions;
const {
  industries,
  solutionLayers,
  specializedWorkflows,
  solutionMatrix,
  deploymentSteps,
  overview
} = getSolutions(locale);
const labelFor = (slug: string) => getProduct(locale, slug)?.name ?? slug;
const heroAlt = locale === 'zh'
  ? '仓库员工使用手持终端和平板扫描库存'
  : 'Warehouse associate scanning inventory with a handheld computer and tablet';
const heroImagePath = withBase('/images/solutions/hero-logistics-2000.webp');
const heroImageUrl = Astro.site ? new URL(heroImagePath, Astro.site).href : heroImagePath;
---

<BaseLayout title={copy.metaTitle} description={copy.metaDescription} image={heroImageUrl} imageAlt={heroAlt} locale={locale}>
  <Header locale={locale} />
  <main>
    <section class="sol-hero">
      <SolutionImage
        base="hero-logistics"
        alt={heroAlt}
        class="sol-hero-bg"
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="sol-hero-overlay"></div>
      <div class="wrap sol-hero-inner">
        <span class="eyebrow">{copy.hero.eyebrow}</span>
        <h1>{copy.hero.titleLine1}<br /><em>{copy.hero.titleLine2}</em></h1>
        <p>{copy.hero.body}</p>
        <div class="sol-hero-actions">
          <a class="button button-accent" href="#industries">{overview.exploreIndustries} ↓</a>
          <a class="button button-glass" href={localizedPath(locale, '/contact/')}>{copy.cta.button} ↗</a>
        </div>
        <div class="sol-hero-chips">
          {industries.map((industry) => (
            <a href={localizedPath(locale, `/solutions/${industry.slug}/`)}>{industry.name}</a>
          ))}
        </div>
      </div>
    </section>

    <section class="sol-proof" aria-label={overview.industriesEyebrow}>
      <div class="wrap sol-proof-grid">
        {overview.proofStats.map((stat) => (
          <div><b>{stat.value}</b><span>{stat.label}</span></div>
        ))}
      </div>
    </section>

    <section class="section" id="industries">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{overview.industriesEyebrow}</span>
            <h2>{overview.industriesTitleLine1}<br />{overview.industriesTitleLine2}</h2>
          </div>
          <p>{overview.industriesBody}</p>
        </div>
        <div class="sol-industry-grid">
          {industries.map((industry) => (
            <a class="sol-industry-card" href={localizedPath(locale, `/solutions/${industry.slug}/`)}>
              <SolutionImage
                base={industry.image.base}
                alt={industry.image.alt}
                sizes="(max-width: 760px) 100vw, 50vw"
              />
              <div class="sol-industry-card-body">
                <span class="sol-index">{industry.index}</span>
                <h3>{industry.name}</h3>
                <p>{industry.summary}</p>
                <span class="sol-card-link">{overview.exploreLabel} <span aria-hidden="true">↗</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.anatomy.eyebrow}</span>
            <h2>{copy.anatomy.titleLine1}<br />{copy.anatomy.titleLine2}</h2>
          </div>
          <p>{copy.anatomy.body}</p>
        </div>
        <div class="anatomy">
          {solutionLayers.map((layer) => (
            <div class="anatomy-step">
              <span class="anatomy-num">{layer.num}</span>
              <h3>{layer.title}</h3>
              <p>{layer.body}</p>
              <div class="anatomy-tags">{layer.tags.map((tag) => <span>{tag}</span>)}</div>
            </div>
          ))}
        </div>
        <p class="note-line">{copy.anatomy.note}</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.matrix.eyebrow}</span>
            <h2>{copy.matrix.titleLine1}<br />{copy.matrix.titleLine2}</h2>
          </div>
          <p>{copy.matrix.body}</p>
        </div>
        <div class="matrix-wrap">
          <table class="matrix-table">
            <thead>
              <tr><th>{copy.matrix.headers.industry}</th><th>{copy.matrix.headers.tasks}</th><th>{copy.matrix.headers.devices}</th><th>{copy.matrix.headers.capture}</th></tr>
            </thead>
            <tbody>
              {solutionMatrix.map((row) => (
                <tr><td>{row.industry}</td><td>{row.tasks}</td><td>{row.devices}</td><td>{row.capture}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note-line">{copy.matrix.note}</p>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.deployment.eyebrow}</span>
            <h2>{copy.deployment.titleLine1}<br />{copy.deployment.titleLine2}</h2>
          </div>
          <p>{copy.deployment.body}</p>
        </div>
        <div class="deploy-grid">
          {deploymentSteps.map((step) => (
            <article class="deploy-step"><h3>{step.title}</h3><p>{step.body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.specialized.eyebrow}</span>
            <h2>{copy.specialized.titleLine1}<br />{copy.specialized.titleLine2}</h2>
          </div>
          <p>{copy.specialized.body}</p>
        </div>
        <div class="special-grid">
          {specializedWorkflows.map((item) => (
            <article class="special-card">
              <span class="mini-label">{item.eyebrow}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul>{item.points.map((point) => <li>{point}</li>)}</ul>
              <div class="device-list special-devices">
                {item.devices.map((device) => (
                  <a class="device-link" href={localizedPath(locale, `/products/${device.slug}/`)}>{labelFor(device.slug)} <span>›</span></a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="sol-oem">
          <div>
            <span class="eyebrow">{overview.oemEyebrow}</span>
            <h2>{overview.oemTitleLine1}<br />{overview.oemTitleLine2}</h2>
            <p>{overview.oemBody}</p>
            <a class="button button-glass" href={localizedPath(locale, '/oem-odm/')}>{overview.oemCta} ↗</a>
          </div>
          <ul>{overview.oemPoints.map((point) => <li>{point}</li>)}</ul>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap cta-band">
        <div>
          <span class="eyebrow">{copy.cta.eyebrow}</span>
          <h2>{copy.cta.titleLine1}<br />{copy.cta.titleLine2}</h2>
          <p>{copy.cta.body}</p>
        </div>
        <a class="button button-accent" href={localizedPath(locale, '/contact/')}>{copy.cta.button} ↗</a>
      </div>
    </section>
  </main>
  <Footer locale={locale} /><InquiryDialog locale={locale} />
</BaseLayout>
