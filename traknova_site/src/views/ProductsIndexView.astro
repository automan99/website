---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InquiryDialog from '../components/InquiryDialog.astro';
import {
  getCategoryLabel,
  getProductCategories,
  getProductFamilies,
  getProductHref
} from '../data/products/catalog';
import { localizedPath, withBase } from '../utils/paths';
import type { Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const copy = dict.products;
const families = getProductFamilies(locale);
const categories = getProductCategories(locale);
const familyIndex = new Map(
  families.map((family, index) => [family.id, index])
);
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} locale={locale}>
  <Header locale={locale} />
  <main>
    <section class="sol-hero product-range-hero">
      <span class="product-range-hero-halo" aria-hidden="true"></span>
      <div class="wrap product-range-hero-grid">
        <div class="product-range-hero-copy">
          <span class="eyebrow">{copy.hero.eyebrow}</span>
          <h1>{copy.hero.titleLine1}<br /><em>{copy.hero.titleLine2}</em></h1>
          <p>{copy.hero.body}</p>
          <div class="sol-hero-chips">
            {categories.map((category) => (
              <a href={`#category-${category.id}`}>{category.label}</a>
            ))}
            <a href="#compare">{copy.anchors.compare}</a>
          </div>
        </div>
        <div class="product-range-hero-visual" aria-hidden="true">
          <img
            class="product-range-hero-lineup"
            src={withBase('/images/products/hero-lineup.webp')}
            alt=""
            width="1473"
            height="810"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.work.eyebrow}</span>
            <h2>{copy.work.titleLine1}<br />{copy.work.titleLine2}</h2>
          </div>
          <p>{copy.work.body}</p>
        </div>
        <div class="work-grid work-grid-4">
          {copy.work.cards.map((card) => (
            <a class="work-card" href={localizedPath(locale, card.href)}>
              <span class="work-tag">{card.tag}</span>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <span class="text-link">{dict.common.actions.exploreSeries} →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft" id="series">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.sections.eyebrow}</span>
            <h2>{copy.sections.titleLine1}<br />{copy.sections.titleLine2}</h2>
          </div>
          <p>{copy.sections.body}</p>
        </div>

        {categories.map((category) => (
          <div class="category-group" id={`category-${category.id}`}>
            <div class="category-heading">
              <h3>{category.label}</h3>
              <p>{dict.common.categoryDescriptions[category.labelKey]}</p>
            </div>
            {category.members.map((family) => {
              const index = familyIndex.get(family.id) ?? 0;
              const defaultVariant =
                family.variants.find((variant) => variant.id === family.defaultVariant) ?? family.variants[0];
              const href = localizedPath(locale, getProductHref(family));
              return (
                <article class:list={['family-showcase', { 'is-reversed': index % 2 === 1 }]} id={family.slug}>
                  <div class="family-showcase-media">
                    <img src={withBase(family.heroImage)} alt={defaultVariant.name} loading="lazy" decoding="async" />
                  </div>
                  <div class="family-showcase-copy">
                    <span class="family-index">{String(index + 1).padStart(2, '0')}</span>
                    <span class="eyebrow">{getCategoryLabel(locale, family.category)}</span>
                    <h2>{family.name}</h2>
                    <p class="family-tagline">{family.tagline}</p>
                    <p>{family.summary}</p>
                    <div class="kpi-row">
                      {family.kpis.map((kpi) => (
                        <div class="kpi"><b>{kpi.value}</b><span>{kpi.label}</span></div>
                      ))}
                    </div>
                    <ul class="variant-tags">
                      {family.variants.map((variant) => <li>{variant.label}</li>)}
                    </ul>
                    <a class="button button-outline" href={href}>{dict.common.actions.exploreSeries} ↗</a>
                  </div>
                </article>
              );
            })}
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="compare">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.comparison.eyebrow}</span>
            <h2>{copy.comparison.titleLine1}<br />{copy.comparison.titleLine2}</h2>
          </div>
          <p>{copy.comparison.body}</p>
        </div>
        <div class="matrix-wrap">
          <table class="matrix-table compare-table">
            <thead>
              <tr>
                <th>{copy.comparison.headers.series}</th>
                <th>{copy.comparison.headers.formFactor}</th>
                <th>{copy.comparison.headers.capture}</th>
                <th>{copy.comparison.headers.os}</th>
                <th>{copy.comparison.headers.battery}</th>
                <th>{copy.comparison.headers.protection}</th>
                <th>{copy.comparison.headers.bestFor}</th>
              </tr>
            </thead>
            <tbody>
              {families.map((family) => (
                <tr>
                  <td><a href={localizedPath(locale, getProductHref(family))}>{family.name}</a></td>
                  <td>{family.comparison.formFactor}</td>
                  <td>{family.comparison.capture}</td>
                  <td>{family.comparison.os}</td>
                  <td>{family.comparison.battery}</td>
                  <td>{family.comparison.protection}</td>
                  <td>{family.comparison.bestFor}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap">
        <div class="split-intro">
          <div>
            <span class="eyebrow">{copy.modules.eyebrow}</span>
            <h2>{copy.modules.titleLine1}<br />{copy.modules.titleLine2}</h2>
          </div>
          <p>{copy.modules.body}</p>
        </div>
        <div class="quality-grid">
          {copy.modules.cards.map((card) => (
            <article class="quality-card">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <ul>{card.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft">
      <div class="wrap faq-split">
        <div>
          <span class="eyebrow">{copy.faq.eyebrow}</span>
          <h2>{copy.faq.titleLine1}<br />{copy.faq.titleLine2}</h2>
          <p>{copy.faq.body}</p>
          <div class="mt-36">
            <a class="button button-outline" href={localizedPath(locale, '/contact/')}>{copy.faq.cta} ↗</a>
          </div>
        </div>
        <div class="faq-list">
          {copy.faq.items.map((faq) => (
            <details><summary>{faq.q}</summary><p>{faq.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap cta-band">
        <div>
          <span class="eyebrow">{copy.cta.eyebrow}</span>
          <h2>{copy.cta.titleLine1}<br />{copy.cta.titleLine2}</h2>
          <p>{copy.cta.body}</p>
        </div>
        <a class="button button-accent" href={localizedPath(locale, '/contact/')}>{copy.cta.button} ↗</a>
      </div>
    </section>
  </main>
  <Footer locale={locale} /><InquiryDialog locale={locale} />
</BaseLayout>
