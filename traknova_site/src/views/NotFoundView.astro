---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localizedPath } from '../utils/paths';
import type { Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const copy = dict.notFound;
---
<BaseLayout title={copy.metaTitle} description={copy.metaDescription} locale={locale}>
  <Header locale={locale} />
  <main>
    <section class="section">
      <div class="wrap not-found">
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.titleLine1}<br /><em>{copy.titleLine2}</em></h1>
        <p>{copy.body}</p>
        <div class="not-found-actions">
          <a class="button button-accent" href={localizedPath(locale, '/')}>{dict.common.actions.backToHome} ↗</a>
          <a class="button button-outline" href={localizedPath(locale, '/products/')}>{dict.common.nav.products}</a>
          <a class="button button-outline" href={localizedPath(locale, '/solutions/')}>{dict.common.nav.solutions}</a>
          <a class="button button-outline" href={localizedPath(locale, '/contact/')}>{dict.common.nav.contact}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
