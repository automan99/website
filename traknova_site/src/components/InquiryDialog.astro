---
import { site } from '../data/site';
---
<div class="dialog" id="inquiry-dialog"><div class="dialog-panel"><button class="dialog-close" data-dialog-close aria-label="Close">×</button><span class="eyebrow">CONTACT OUR SALES TEAM</span><h2>Request a Quote</h2><p>Tell us about your project. Our team will follow up with the right product information.</p>
<form action={site.formspreeEndpoint} method="POST">
  <div class="form-grid">
    <label>Full Name *<input name="name" required /></label>
    <label>Business Email *<input name="email" type="email" required /></label>
    <label>Company<input name="company" /></label>
    <label>Country / Region *<input name="country" required /></label>
    <label>Product Interest *<select name="product" required><option value="">Select a category</option><option>Rugged PDA</option><option>RFID / NFC</option><option>Industrial Tablet</option><option>OEM / ODM</option></select></label>
    <label>Estimated Quantity<select name="quantity"><option>Not decided</option><option>1–50</option><option>50–200</option><option>200–1,000</option><option>1,000+</option></select></label>
    <label class="full">Project Details *<textarea name="message" required></textarea></label>
    <button class="button button-accent full" type="submit">Submit Inquiry →</button>
  </div>
  <input type="hidden" name="_subject" value="New TRAKNOVA website inquiry" />
</form></div></div>