---
import { getCategoryLabel, getProductHref, type ProductFamily } from '../data/products/catalog';
import { localizedPath, withBase } from '../utils/paths';
import type { Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  family: ProductFamily;
  locale: Locale;
  compact?: boolean;
}

const { family, locale, compact = false } = Astro.props;
const dict = getDictionary(locale);
const href = localizedPath(locale, getProductHref(family));
const defaultVariant =
  family.variants.find((variant) => variant.id === family.defaultVariant) ?? family.variants[0];
const chips = compact ? family.tags : family.variants.map((variant) => variant.label);
---
<article class:list={['family-card-v2', { 'is-compact': compact }]} data-product-family={family.id}>
  <a class="family-card-media" href={href} tabindex="-1" aria-hidden="true">
    <img src={withBase(family.heroImage)} alt={defaultVariant.name} loading="lazy" decoding="async" />
  </a>
  <div class="family-card-copy">
    <span class="product-category">{getCategoryLabel(locale, family.category)}</span>
    <h3><a href={href}>{family.name}</a></h3>
    <p class="family-card-tagline">{family.tagline}</p>
    <ul class="variant-tags">
      {chips.map((chip) => <li>{chip}</li>)}
    </ul>
    {!compact && (
      <div class="kpi-row">
        {family.kpis.map((kpi) => (
          <div class="kpi"><b>{kpi.value}</b><span>{kpi.label}</span></div>
        ))}
      </div>
    )}
    <a class="text-link" href={href}>{dict.common.actions.exploreSeries} →</a>
  </div>
</article>
