---
import { site } from '../data/site';
import { withBase, localizedPath, inquiryPath } from '../utils/paths';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { getDictionary } from '../i18n';
import { getProductFamilies } from '../data/products/catalog';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale);
const families = getProductFamilies(locale);
const showCookieSettings = site.consent?.enabled !== false;
---
<footer class="footer"><div class="wrap footer-grid">
  <div>
    <a class="logo logo-light" href={localizedPath(locale, '/')}><img class="logo-mark" src={withBase('/images/brand/logo.png')} alt="" width="38" height="38" decoding="async" /><span>{site.brand}<small>{dict.site.logoSubline}</small></span></a>
    <p>{dict.footer.description}</p>
  </div>
  <div>
    <h4>{dict.footer.columns.productsTitle}</h4>
    {families.map((family) => (
      <a href={localizedPath(locale, `/products/${family.slug}/`)}>{family.name}</a>
    ))}
    <a href={localizedPath(locale, '/products/')}>{dict.footer.columns.productsAll}</a>
  </div>
  <div>
    <h4>{dict.footer.columns.solutionsTitle}</h4>
    <a href={localizedPath(locale, '/solutions/logistics/')}>{dict.footer.columns.solutionsLogistics}</a>
    <a href={localizedPath(locale, '/solutions/manufacturing/')}>{dict.footer.columns.solutionsManufacturing}</a>
    <a href={localizedPath(locale, '/solutions/retail/')}>{dict.footer.columns.solutionsRetail}</a>
    <a href={localizedPath(locale, '/solutions/field-service/')}>{dict.footer.columns.solutionsField}</a>
  </div>
  <div>
    <h4>{dict.footer.columns.companyTitle}</h4>
    <a href={localizedPath(locale, '/about/')}>{dict.footer.columns.companyAbout}</a>
    <a href={localizedPath(locale, '/oem-odm/')}>{dict.footer.columns.companyOem}</a>
    <a href={localizedPath(locale, '/contact/')}>{dict.footer.columns.companyContact}</a>
    <a href={inquiryPath(locale)}>{dict.footer.columns.companyQuote}</a>
  </div>
  <div>
    <h4>{dict.footer.columns.contactTitle}</h4>
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">{dict.footer.columns.contactWhatsapp}</a>
    <a href={site.facebook} target="_blank" rel="noreferrer">{dict.footer.columns.contactFacebook}</a>
    <p>{dict.footer.columns.contactNote}</p>
  </div>
</div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} {site.brand}. {dict.footer.rights}</span><span><a href={localizedPath(locale, '/privacy/')}>{dict.footer.privacy}</a> · <a href={localizedPath(locale, '/terms/')}>{dict.footer.terms}</a>{showCookieSettings && <><span aria-hidden="true"> · </span><button type="button" class="footer-cookie-button" data-consent-open>{dict.footer.cookieSettings}</button></>}</span></div></footer>
<div class="floating-contact"><a aria-label={dict.footer.floatingWhatsappAria} href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noreferrer">WA</a><a aria-label={dict.footer.floatingEmailAria} href={`mailto:${site.email}`}>✉</a></div>
<style>
  .footer-cookie-button {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .footer-cookie-button:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
