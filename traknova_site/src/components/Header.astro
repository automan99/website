---
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const current = base && pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
const isActive = (path: string) => (path === '/' ? current === '/' || current === '' : current.startsWith(path));
const navItems = [
  { href: '/products/', label: 'Products' },
  { href: '/solutions/', label: 'Solutions' },
  { href: '/oem-odm/', label: 'OEM / ODM' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' }
];
---
<div class="utility"><div class="wrap utility-inner"><span>ENGINEERED FOR THE FRONTLINE. BUILT FOR BUSINESS.</span><span>Global Sales · {site.email}</span></div></div>
<header class="header"><div class="wrap header-inner">
  <a class="logo" href={withBase('/')}><span class="logo-mark">T<span>↗</span></span><span>{site.brand}<small>INDUSTRIAL MOBILITY</small></span></a>
  <nav class="desktop-nav" aria-label="Primary">{navItems.map((item) => <a href={withBase(item.href)} class:list={{ 'is-active': isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
  <a class="button button-accent nav-cta" href={withBase('/contact/')}>Get a Quote <span>↗</span></a>
  <button class="menu-toggle" data-menu-toggle aria-label="Toggle navigation">☰</button>
</div><nav class="mobile-nav" aria-label="Mobile" data-mobile-menu>{navItems.map((item) => <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav></header>
