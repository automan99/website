---
import {
  getProductHref,
  type ProductCategoryGroup
} from '../data/products/catalog';
import { localizedPath, withBase } from '../utils/paths';
import type { Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  category: ProductCategoryGroup;
  locale: Locale;
  description: string;
}

const { category, locale, description } = Astro.props;
const dict = getDictionary(locale);
const defaultVariant =
  category.representative.variants.find(
    (variant) => variant.id === category.representative.defaultVariant
  ) ?? category.representative.variants[0];
const href = localizedPath(locale, `/products/#category-${category.id}`);

type Chip = { label: string; href?: string };
let chips: Chip[] = [];
if (category.members.length > 1) {
  chips = category.members.map((family) => ({
    label: family.name,
    href: localizedPath(locale, getProductHref(family))
  }));
} else {
  const family = category.representative;
  chips =
    family.variants.length > 1
      ? family.variants.map((variant) => ({
          label: variant.label,
          href: localizedPath(locale, getProductHref(family, variant.id))
        }))
      : family.tags.map((tag) => ({ label: tag }));
}
---
<article class="family-card-v2 category-card" data-product-category={category.id}>
  <a class="family-card-media" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={withBase(category.representative.heroImage)}
      alt={defaultVariant.name}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="family-card-copy">
    <span class="product-category">{dict.common.nav.products}</span>
    <h3><a href={href}>{category.label}</a></h3>
    <p class="family-card-tagline">{description}</p>
    <ul class="variant-tags category-lines">
      {chips.map((chip) => (
        <li>{chip.href ? <a href={chip.href}>{chip.label}</a> : chip.label}</li>
      ))}
    </ul>
    <a class="text-link" href={href}>{dict.common.actions.viewCategory} →</a>
  </div>
</article>
