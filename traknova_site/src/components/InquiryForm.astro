---
import { site } from '../data/site';
import { localizedPath } from '../utils/paths';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale);
const options = dict.inquiry.options;
const thankYouPath = localizedPath(locale, '/thank-you/');
const thankYouUrl = Astro.site ? new URL(thankYouPath, Astro.site).href : thankYouPath;
---
<form action={site.formspreeEndpoint} method="POST">
  <div class="form-grid">
    <label>{dict.inquiry.fields.fullName} *<input name="name" autocomplete="name" required /></label>
    <label>{dict.inquiry.fields.businessEmail} *<input name="email" type="email" autocomplete="email" required /></label>
    <label>{dict.inquiry.fields.company}<input name="company" autocomplete="organization" /></label>
    <label>{dict.inquiry.fields.country} *<input name="country" autocomplete="country-name" required /></label>
    <label>{dict.inquiry.fields.product} *<select name="product" required><option value="">{options.product.placeholder}</option><option value="rfid-handhelds">{options.product.rfidHandhelds}</option><option value="ht600">{options.product.ht600}</option><option value="y100">{options.product.y100}</option><option value="oem">{options.product.oem}</option><option value="not-sure">{options.product.notSure}</option></select></label>
    <label>{dict.inquiry.fields.application}<select name="application"><option value="">{options.application.placeholder}</option><option value="Warehouse &amp; Logistics">{options.application.logistics}</option><option value="Manufacturing">{options.application.manufacturing}</option><option value="Retail &amp; Commerce">{options.application.retail}</option><option value="Field Service &amp; Assets">{options.application.field}</option><option value="Healthcare / Public Services">{options.application.healthcare}</option><option value="Other">{options.application.other}</option></select></label>
    <label>{dict.inquiry.fields.cooperation}<select name="cooperation"><option value="Standard product">{options.cooperation.standard}</option><option value="Private label">{options.cooperation.privateLabel}</option><option value="Configured product">{options.cooperation.configured}</option><option value="Project development">{options.cooperation.project}</option><option value="Not sure">{options.cooperation.notSure}</option></select></label>
    <label>{dict.inquiry.fields.quantity}<select name="quantity"><option value="Not decided">{options.quantity.notDecided}</option><option value="1–50">{options.quantity.q1_50}</option><option value="50–200">{options.quantity.q50_200}</option><option value="200–1,000">{options.quantity.q200_1000}</option><option value="1,000+">{options.quantity.q1000plus}</option></select></label>
    <label class="full">{dict.inquiry.fields.details} *<textarea name="message" required placeholder={dict.inquiry.detailsPlaceholder}></textarea></label>
    <p class="full form-note">{dict.inquiry.privacyPrefix}<a href={localizedPath(locale, '/privacy/')}>{dict.inquiry.privacyLinkLabel}</a>{dict.inquiry.privacySuffix}</p>
    <button class="button button-accent full" type="submit">{dict.inquiry.submit} →</button>
  </div>
  <input type="hidden" name="_subject" value={dict.inquiry.subject} />
  <input type="hidden" name="_language" value={locale} />
  <input type="hidden" name="_next" value={thankYouUrl} />
</form>
