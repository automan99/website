---
import { getCategoryLabel, type Product } from '../data/products';
import { localizedPath, withBase } from '../utils/paths';
import type { Locale } from '../i18n/config';

interface Props {
  product: Product;
  locale: Locale;
  label: string;
}

const { product, locale, label } = Astro.props;
const fallbackByCategory = {
  'Rugged PDA': 'device-pda.svg',
  RFID: 'device-rfid.svg',
  'Industrial Tablet': 'device-tablet.svg'
} as const;
const silhouette = product.category === 'Industrial Tablet' || /tablet/i.test(product.name)
  ? 'device-tablet.svg'
  : fallbackByCategory[product.category];
const image = withBase(`/images/products/${silhouette}`);
---

<article class="sol-device-card">
  <div class="sol-device-media is-silhouette">
    <img src={image} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="sol-device-copy">
    <span class="sol-device-cat">{getCategoryLabel(locale, product.category)}</span>
    <h3>{product.name}</h3>
    <p>{product.summary}</p>
    <a class="text-link" href={localizedPath(locale, `/products/${product.slug}/`)}>{label} →</a>
  </div>
</article>
