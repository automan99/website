---
import {
  getCategoryLabel,
  getProductHref,
  type ProductFamily,
  type ProductVariant
} from '../data/products/catalog';
import { localizedPath, withBase } from '../utils/paths';
import type { Locale } from '../i18n/config';
import type { ProductCategory } from '../data/products/types';

interface Props {
  family: ProductFamily;
  variant: ProductVariant;
  locale: Locale;
  label: string;
}

const { family, variant, locale, label } = Astro.props;
const silhouettes: Record<ProductCategory, string> = {
  'rfid-handheld': 'device-rfid.svg',
  'barcode-handheld': 'device-barcode.svg',
  'rugged-tablet': 'device-tablet.svg'
};
const silhouette = silhouettes[family.category] ?? 'device-rfid.svg';
const image = withBase(`/images/products/${silhouette}`);
---
<article class="sol-device-card">
  <div class="sol-device-media is-silhouette">
    <img src={image} alt="" loading="lazy" decoding="async" />
  </div>
  <div class="sol-device-copy">
    <span class="sol-device-cat">{getCategoryLabel(locale, family.category)}</span>
    <h3>{variant.name}</h3>
    <p>{variant.summary}</p>
    <a class="text-link" href={localizedPath(locale, getProductHref(family, variant.id))}>{label} →</a>
  </div>
</article>
