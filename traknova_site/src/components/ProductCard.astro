---
import { withBase, localizedPath } from '../utils/paths';
import { getCategoryLabel, type Product } from '../data/products';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { getDictionary } from '../i18n';

interface Props {
  product: Product;
  locale?: Locale;
}

const { product, locale = DEFAULT_LOCALE } = Astro.props;
const dict = getDictionary(locale);
const productHref = localizedPath(locale, `/products/${product.slug}/`);
---
<article class="product-card" data-product-category={product.category}>
  <a href={productHref} class="product-image"><img src={withBase(product.image)} alt={product.name} loading="lazy" /></a>
  <div class="product-copy"><span class="product-category">{getCategoryLabel(locale, product.category)}</span><h3><a href={productHref}>{product.name}</a></h3><p>{product.summary}</p><a class="text-link" href={productHref}>{dict.common.actions.exploreProduct} <span>→</span></a></div>
</article>
