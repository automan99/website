---
import { withBase } from '../utils/paths';
const { product } = Astro.props;
---
<article class="product-card" data-product-category={product.category}>
  <a href={withBase(`/products/${product.slug}/`)} class="product-image"><img src={withBase(product.image)} alt={product.name} loading="lazy" /></a>
  <div class="product-copy"><span class="product-category">{product.category}</span><h3><a href={withBase(`/products/${product.slug}/`)}>{product.name}</a></h3><p>{product.summary}</p><a class="text-link" href={withBase(`/products/${product.slug}/`)}>Explore product <span>→</span></a></div>
</article>